# Common environment variables

# Version
VITE_VERSION = 2.5.5

# Port
VITE_PORT = 3006

# Site base URL
VITE_BASE_URL = /art-design-pro/

# API base URL
VITE_API_URL = https://be-express-shortlink.vercel.app/

# Access mode (frontend | backend)
VITE_ACCESS_MODE = frontend

# Send cookies on cross-origin requests (backend must support this)
VITE_WITH_CREDENTIALS = false

# Enable route info
VITE_OPEN_ROUTE_INFO = false

# Lock screen encryption key
VITE_LOCK_ENCRYPT_KEY = s3cur3k3y4adpro
